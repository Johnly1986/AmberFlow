{
  "name": "farehaven-replica6",
  "language": "en",
  "site_label": "FareHaven",
  "site_dir": "transfer/site6",
  "ledger_js": "() => window.__FAREHAVEN_LEDGER || {}",
  "data_module": "transfer.data6",
  "params": {
    "from": "昆明",
    "to": "北京",
    "city": "北京",
    "window_label": "08:00-18:00",
    "cap_label": "¥300"
  },
  "slots": {"window": "0800-1800", "sort": "price_asc", "cap": "300"},
  "collect_roles": ["record_page"],
  "phases": [
    {
      "phase": "entry",
      "stage": "flight",
      "repeat": "once",
      "steps": [
        {
          "role": "entry",
          "desc": "从{site_label}首页进入机票搜索页（{from} → {to}）",
          "path": "index.html",
          "hint": "#nav-flights",
          "signal": {"css_text_contains": ["#page-title", "Flights"]}
        }
      ]
    },
    {
      "phase": "flights",
      "stage": "flight",
      "repeat": "per_date",
      "steps": [
        {
          "role": "dismiss_promo",
          "desc": "如果 {date}（{wd}）的机票页弹出了促销遮罩，就先关掉它",
          "path": "flights.html",
          "query": {"date": "{date}"},
          "hint": "#promo-dismiss",
          "when": {"css_exists": ["#promo-modal"]},
          "signal": {"css_text_contains": ["#promo-state", "dismissed"]}
        },
        {
          "role": "filter_window",
          "desc": "打开 {date}（{wd}）{from}到{to}的航班列表，并把出发时段筛选为 {window_label}",
          "path": "flights.html",
          "query": {"date": "{date}"},
          "hint": "#window",
          "signal": {"css_text_contains": ["#window-state", "08:00-18:00"]}
        },
        {
          "role": "sort_price",
          "desc": "把 {date}（{wd}）的航班列表按价格从低到高排序",
          "path": "flights.html",
          "query": {"date": "{date}", "window": "0800-1800"},
          "hint": "#sort",
          "signal": {"css_text_contains": ["#sort-state", "price (low to high)"]}
        },
        {
          "role": "record_lowest",
          "desc": "记录 {date}（{wd}）{window_label} 区间内最低价的航班",
          "path": "flights.html",
          "query": {"date": "{date}", "window": "0800-1800", "sort": "price_asc"},
          "hint": "#record-cheapest",
          "signal": {"css_text_contains": ["#log", "Recorded"]}
        }
      ]
    },
    {
      "phase": "hotel",
      "stage": "hotel",
      "repeat": "per_checkin",
      "steps": [
        {
          "role": "set_cap",
          "desc": "打开 {city} {checkin} 入住的酒店列表，并把价格上限设为 {cap_label}",
          "path": "hotels.html",
          "query": {"checkin": "{checkin}"},
          "hint": "#cap",
          "signal": {"css_text_contains": ["#cap-state", "300"]}
        },
        {
          "role": "sort_price",
          "desc": "把 {city} {checkin} 入住的酒店列表按价格从低到高排序",
          "path": "hotels.html",
          "query": {"checkin": "{checkin}", "cap": "300"},
          "hint": "#sort",
          "signal": {"css_text_contains": ["#sort-state", "price (low to high)"]}
        }
      ]
    },
    {
      "phase": "collect",
      "stage": "hotel",
      "repeat": "per_checkin",
      "steps": [
        {
          "role": "record_page",
          "desc": "记录当前显示的每一家酒店",
          "path": "hotels.html",
          "query": {"checkin": "{checkin}", "cap": "300", "sort": "price_asc"},
          "hint": "#record-all",
          "signal": {"css_text_contains": ["#log", "Recorded"]}
        }
      ]
    }
  ]
}
