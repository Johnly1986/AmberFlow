# AmberFlow 环境变量示例（.env.example）
#
# 生成物，勿手改：由 tools/config-example.ts 从 src/support/config-schema.ts 生成（34 键 / 8 组）。
# 重新生成：npm run config:example；漂移校验：npm run config:example:check（npm run check 的一环）。
#
# 语义：空值 = 自动/不覆盖（不是「关闭」）；每行的值就是引擎的内建默认值。
# 优先级：CLI 旗标 > 环境变量 > 项目配置 > 用户配置 > 旧 rc > 内建缺省。
# 凭据：只留本机（配置文件已被 .gitignore 排除），绝不进被审计产物；本示例一律空串。
# 未知键：写进 rc / 用户/项目配置会在加载期以未知键拒绝，不会静默生效。

# --- 决策模型产物 ---
# 本地 ONNX 图路径；空 = <repo>/models/laya_dec.onnx
LAYA_ONNX_MODEL=
# tokenizer 目录；空 = 自动发现 HF 缓存/项目目录
LAYA_TOKENIZER_DIR=
# HuggingFace 根目录；空 = 默认缓存位置
HF_HOME=
# HuggingFace hub 缓存；空 = 默认位置
HF_HUB_CACHE=

# --- 决策服务（统一配置） ---
# 线上决策服务地址；空 = 使用本地模型
AMBERFLOW_DECISION_BASE_URL=
# 线上模型名；无服务地址时是本地 checkpoint（空 = english；可填 multilingual）
AMBERFLOW_DECISION_MODEL=
# 线上服务密钥；本地自托管可空
AMBERFLOW_DECISION_API_KEY=
# systemone 或 openai-decisions；空 = 按 URL 自动推断
AMBERFLOW_DECISION_PROTOCOL=
# 闸门刻度；空 = 不覆盖 provider 自报/全局缺省（0.5）；会被 --conf-floor（或 AMBERFLOW_CONF_FLOOR）覆盖
AMBERFLOW_DECISION_FLOOR=
# score 语义：calibrated_prob/entropy_conf/rank_only
AMBERFLOW_DECISION_SCORE_KIND=calibrated_prob
# 单次请求超时（毫秒）
AMBERFLOW_DECISION_TIMEOUT_MS=30000
# 1 = choice 题带 url/title/正文；0 = 只带 goal
AMBERFLOW_DECISION_STATE_CONTEXT=1
# choice 选项下限；自托管 JevK5 用 2
AMBERFLOW_DECISION_MIN_OPTIONS=1
# 额外请求头（JSON 对象，如 {"x-opencode-session":"…"}）；空/坏 JSON = 不带头。路由头与 Authorization 分开：前者路由，后者身份
AMBERFLOW_DECISION_HEADERS=

# --- 外层 LLM（事后审计） ---
# OpenAI 兼容服务地址（仅供事后审计 LLMAuditor）；空 = 用内置替身。规划归 Agent：引擎内没有 LLM 规划面
OPENAI_BASE_URL=
# 外层 LLM 密钥（事后审计用）
OPENAI_API_KEY=
# 审计模型名
AUDIT_MODEL=gpt-4o-mini

# --- 浏览器与落盘 ---
# Playwright 浏览器目录；空 = 自动发现
PLAYWRIGHT_BROWSERS_PATH=
# 用户作用域目录；空 = ~/.amberflow
AMBERFLOW_HOME=
# 应用运行产物目录；空 = 系统临时目录/amberflow-apps
AMBERFLOW_APPS_OUT=
# DSH 桥指向的 checkout；空 = 自动发现
AMBERFLOW_REPO=

# --- 人工步骤与操作节奏 ---
# 步骤间最小延迟（毫秒）
AMBERFLOW_STEP_DELAY_MS=0
# 动作间最小延迟（毫秒）
AMBERFLOW_ACTION_DELAY_MS=0

# --- 运行参数（CLI 旗标的配置默认值） ---
# 1 = 显示浏览器窗口
AMBERFLOW_HEADFUL=0
# 闸门刻度覆盖；空 = 不覆盖。优先级：--conf-floor / 此键 > AMBERFLOW_DECISION_FLOOR > 全局缺省（0.5）
AMBERFLOW_CONF_FLOOR=
# 1 = 打开 tiered hint 实验
AMBERFLOW_TIERED_HINT=0
# 1 = 危险动作仍逐次确认（默认，安全）；0 = 放行（旧行为，需显式）
AMBERFLOW_CONFIRM_SAFE=1
# 1 = 跳过应用数据腿
AMBERFLOW_NO_SOURCES=0
# 1 = 只输出结论
AMBERFLOW_QUIET=0

# --- 决策开关（decision.*，行为变更面） ---
# on_ambiguous:act 的歧义命中顺序：dom-preorder（缺省，命中 act 时刻 DOM 序首个 actionable 候选）| pool-order（旧池序，回退开关）
AMBERFLOW_AMBIGUOUS_ORDERING=dom-preorder
# act 的 #id hint 池内未命中时是否做 live-DOM getElementById 单点直查兜底：1（缺省）= 兜底；0 = 维持旧 target_not_found（回退开关）
AMBERFLOW_ID_FALLBACK=1
# act 池上限（decision.act_pool_cap；空 = 引擎默认 64）。仅观测面可配；默认值调整需另行变更
AMBERFLOW_ACT_POOL_CAP=
# 池构建配额模型：legacy（缺省，优先级逐出）| quota（双配额：viewport 保底 + id-backed 保留 + 壳元素限额；灰度站点显式开启）
AMBERFLOW_POOL_QUOTA_MODE=legacy

# --- 实验开关（opt-in） ---
# 1 = 站点事实注入模型请求面（fenced 块；缺省 OFF = notes 原样）
AMBERFLOW_SITE_FACTS_INTO_MODEL=0

# --- 不在配置面的环境变量（消费点直接读取 env，写进 rc/配置会被未知键拒绝）---
# AMBERFLOW_BROWSER_CHANNEL：`chrome` 或 `headless-shell`；部署/CI 的机器级覆盖，优先于 `meta.policy.browser`（缺省 headless-shell）（`src/browser/browser-env.ts`）
# AMBERFLOW_RESCUE_SHADOW：`1` = 介入/救援影子模式（只记录不阻断）；其余值一律视为关（`src/app/intervention-shadow.ts`）
