# AmberFlow 环境变量示例（.env.example）
#
# 单一事实来源：src/support/config-schema.ts（29 键）。本文件由人工同步，
# 与 configs/amberflowrc.example.json 的键集一致；两边漂移会在
# `npm run config:example:check` 或 review 时被发现。
#
# 语义：空值 = 自动/不覆盖（不是「关闭」）。优先级：CLI 旗标 > 环境变量 > 项目配置 >
# 用户配置 > 旧 rc > 内建缺省。凭据只留本机，绝不进被审计产物（AGENTS.md 硬规则）。
# 更完整的说明（每键的类型/默认/作用点）见 docs/CONFIG_REFERENCE.md。

# --- 决策服务（在线三件套：填 BASE_URL + MODEL + API_KEY 即启用；留空 = 本地 checkpoint）---
AMBERFLOW_DECISION_BASE_URL=
AMBERFLOW_DECISION_MODEL=
AMBERFLOW_DECISION_API_KEY=
AMBERFLOW_DECISION_PROTOCOL=
AMBERFLOW_DECISION_FLOOR=
AMBERFLOW_DECISION_SCORE_KIND=calibrated_prob
AMBERFLOW_DECISION_TIMEOUT_MS=30000
AMBERFLOW_DECISION_STATE_CONTEXT=1
AMBERFLOW_DECISION_MIN_OPTIONS=1

# --- 本地模型工件 ---
LAYA_ONNX_MODEL=
LAYA_TOKENIZER_DIR=
HF_HOME=
HF_HUB_CACHE=

# --- provider 专属（OpenAI 兼容通道；仅协议适配层读取）---
OPENAI_BASE_URL=
OPENAI_API_KEY=
AUDIT_MODEL=gpt-4o-mini

# --- 浏览器 ---
PLAYWRIGHT_BROWSERS_PATH=

# --- 目录布局 ---
AMBERFLOW_HOME=
AMBERFLOW_APPS_OUT=
AMBERFLOW_REPO=

# --- 运行节奏（毫秒；0 = 关）---
AMBERFLOW_STEP_DELAY_MS=0
AMBERFLOW_ACTION_DELAY_MS=0

# --- 行为开关（0/1）---
AMBERFLOW_HEADFUL=0
AMBERFLOW_TIERED_HINT=0
AMBERFLOW_CONFIRM_SAFE=1
AMBERFLOW_NO_SOURCES=0
AMBERFLOW_QUIET=0
AMBERFLOW_SITE_FACTS_INTO_MODEL=0

# 置信度闸门刻度：空 = provider 自报或全局 0.25
AMBERFLOW_CONF_FLOOR=
