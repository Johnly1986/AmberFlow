{
  "name": "ctrip-flights-h5",
  "label": "携程 H5 线路页（真实机票价格）",
  "transport": {
    "client": "curl",
    "url_template": "https://m.ctrip.com/html5/flight/{dcity}-{acity}-day-{n}.html",
    "note": "只有 curl 能过 WhaleGuard 指纹（curl 200 / curl+Chrome UA、httpx、Chromium 全部 432）",
    "block_markers": [
      "whaleguard"
    ]
  },
  "constants": {
    "dcity": "kmg",
    "acity": "bjs"
  },
  "default_dates": "next_week",
  "date": {
    "params": {
      "n": "day_offset"
    }
  },
  "extract": {
    "kind": "json_in_script",
    "var": "window.__INITIAL_STATE__",
    "rows": "listData.flights",
    "date": "listData.ddate",
    "strip": "listData.dateList[].date",
    "fields": {
      "flight_no": "flightItem.flights[].flightNo|join:+",
      "airline": "flightItem.flights[0].airline.name",
      "dep": "flightItem.flights[0].dtime|time",
      "arr": {
        "path": "flightItem.flights[-1].atime",
        "ops": [
          "time"
        ],
        "compare_day_with": "flightItem.flights[0].dtime"
      },
      "dep_port": "flightItem.flights[0].dport.name",
      "arr_port": "flightItem.flights[-1].aport.name",
      "arr_city": "flightItem.flights[-1].aport.cityCode",
      "stops": {
        "path": "flightItem.flights",
        "ops": [
          "len-1"
        ]
      },
      "price": "price",
      "cabin": "displayClass",
      "discount": "drate"
    }
  },
  "filters": {
    "time_field": "dep",
    "window": [
      "08:00",
      "18:00"
    ]
  },
  "counts": [
    {
      "key": "in_window",
      "label": "时段内班次"
    },
    {
      "key": "in_window_nonstop",
      "label": "时段内直飞",
      "where": {
        "stops": 0
      }
    }
  ],
  "selects": [
    {
      "key": "best",
      "label": "最低价（含经停）",
      "sort_by": [
        "price",
        "dep"
      ]
    },
    {
      "key": "best_nonstop",
      "label": "直飞最低",
      "sort_by": [
        "price",
        "dep"
      ],
      "where": {
        "stops": 0
      }
    }
  ],
  "report": {
    "title": "携程真实机票价格（H5 线路页）",
    "source_note": "`m.ctrip.com/html5/flight/<dcity>-<acity>-day-N.html` 的 `window.__INITIAL_STATE__.listData.flights`（携程服务端渲染的完整航班列表；N = 目标日期 − 今天）",
    "preview": {
      "columns": [
        "flight_no",
        "dep",
        "arr",
        "airline",
        "stops",
        "price"
      ],
      "limit": 6
    },
    "notes": [
      "用例口径：出发时刻落在 [08:00, 18:00] 闭区间，取最低价（同价取更早起飞）。",
      "带 `+1` 的是次日到达的联程票；若要求当日到达请看“直飞最低”一列。",
      "抓取日期与页面上的价格都是**抓取当时**的携程报价，会随时间和登录态变化。",
      "酒店那一半没有对应通道（匿名访客拿不到价格节点），见 sources/ctrip-hotels-pc.json。"
    ],
    "currency": "¥"
  }
}
