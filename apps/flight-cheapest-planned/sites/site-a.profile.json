{
  "spec_version": 2,
  "site": "site-a",
  "label": "planned profile for site-a",
  "page_query": {
    "pick-date": "from={from}&to={to}",
    "pick-cheapest": "from={from}&to={to}&date={date_code}",
    "purchase": "from={from}&to={to}&date={date_code}"
  },
  "fill_keys": {
    "submit-search": {
      "出发城市": "from",
      "到达城市": "to"
    }
  },
  "list_extract": {
    "pick-cheapest": {
      "row_sel": "tr.flight-item",
      "fields": {
        "price": {
          "sel": ".price",
          "op": "int"
        },
        "flight": {
          "sel": ".fno",
          "op": "str"
        }
      },
      "act_sel": "button.btn-pick"
    }
  },
  "frozen_signals": {
    "open-flights": {
      "url_contains": "/search.html"
    },
    "submit-search": {
      "url_contains": "/results.html"
    },
    "pick-date": {
      "css_text_equals": [
        "#list-state",
        "列表已更新 {date_code}"
      ]
    },
    "pick-cheapest": {
      "url_contains": "/purchase.html"
    },
    "purchase": {
      "url_contains": "/done.html"
    }
  },
  "steps": {},
  "pages": {
    "home": "index.html",
    "search": "search.html",
    "results": "results.html",
    "purchase": "purchase.html",
    "done": "done.html"
  }
}
