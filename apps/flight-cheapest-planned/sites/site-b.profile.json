{
  "spec_version": 2,
  "site": "site-b",
  "label": "planned profile for site-b",
  "page_query": {
    "pick-date": "from={from}&to={to}",
    "pick-cheapest": "from={from}&to={to}&date={date_code}",
    "purchase": "from={from}&to={to}&date={date_code}"
  },
  "fill_keys": {
    "submit-search": {
      "Departure city": "from",
      "Arrival city": "to"
    }
  },
  "list_extract": {
    "pick-cheapest": {
      "row_sel": "div.fare-row",
      "fields": {
        "price": {
          "sel": ".fare-price",
          "op": "int"
        },
        "flight": {
          "sel": ".fno",
          "op": "str"
        }
      },
      "act_sel": "button.select-fare"
    }
  },
  "frozen_signals": {
    "open-flights": {
      "url_contains": "/fare-query.html"
    },
    "submit-search": {
      "url_contains": "/fare-list.html"
    },
    "pick-date": {
      "css_text_equals": [
        "[data-test=query-line]",
        "{from} -> {to} · {date_code}"
      ]
    },
    "pick-cheapest": {
      "url_contains": "/fare-buy.html"
    },
    "purchase": {
      "url_contains": "/fare-done.html"
    }
  },
  "steps": {},
  "pages": {
    "home": "home.html",
    "search": "fare-query.html",
    "results": "fare-list.html",
    "purchase": "fare-buy.html",
    "done": "fare-done.html"
  }
}
