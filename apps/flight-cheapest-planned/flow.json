{
  "spec_version": 2,
  "id": "flight-cheapest-planned",
  "label": "在携程上订一张5月18日昆明到北京价格最低的机票",
  "goal": "在携程上订一张5月18日昆明到北京价格最低的机票",
  "model": "english",
  "slots": {
    "date_label": "5月18日",
    "date_code": "05-18",
    "date_label_en": "May 18",
    "from": "昆明",
    "to": "北京"
  },
  "sites": {
    "site-a": {
      "label": "site-a",
      "start_url": "semantic/site-a/index.html"
    },
    "site-b": {
      "label": "site-b",
      "start_url": "semantic/site-b/home.html"
    }
  },
  "pages": {
    "home": "index.html",
    "search": "search.html",
    "results": "results.html",
    "purchase": "purchase.html",
    "done": "done.html"
  },
  "steps": [
    {
      "id": "open-flights",
      "desc": "进入机票预订频道",
      "page": "home",
      "semantic_target": {
        "role": "link",
        "text": [
          "机票",
          "Flight",
          "Flights",
          "flight"
        ]
      },
      "signal": {
        "page": "search"
      }
    },
    {
      "id": "submit-search",
      "desc": "在出发地填入{from}、到达地填入{to}，然后点击搜索",
      "page": "search",
      "semantic_targets": [
        {
          "role": "input",
          "text": [
            "出发",
            "Departure",
            "departure",
            "From",
            "depart"
          ]
        },
        {
          "role": "input",
          "text": [
            "到达",
            "Arrival",
            "arrival",
            "To",
            "arrive"
          ]
        },
        {
          "role": "button",
          "text": [
            "搜索",
            "Search",
            "search",
            "查询"
          ]
        }
      ],
      "fills": [
        "from",
        "to"
      ],
      "signal": {
        "page": "results"
      }
    },
    {
      "id": "pick-date",
      "desc": "选择出发日期{date_label}",
      "page": "results",
      "page_query": "from={from}&to={to}",
      "semantic_target": {
        "role": "button",
        "text": [
          "{date_label}",
          "{date_label_en}"
        ]
      },
      "signal": {
        "page": "results"
      }
    },
    {
      "id": "pick-cheapest",
      "desc": "判断最低价机票并选中最低价的航班",
      "page": "results",
      "page_query": "from={from}&to={to}&date={date_code}",
      "list_step": {
        "op": "min",
        "by": "price"
      },
      "signal": {
        "page": "purchase"
      }
    },
    {
      "id": "purchase",
      "desc": "点击购买提交订单",
      "page": "purchase",
      "page_query": "from={from}&to={to}&date={date_code}",
      "semantic_target": {
        "role": "button",
        "text": [
          "购买",
          "Purchase",
          "Buy",
          "Book",
          "purchase",
          "buy"
        ]
      },
      "signal": {
        "page": "done"
      },
      "dangerous": true
    }
  ],
  "invariants": [
    {
      "page": "done"
    }
  ],
  "notes": [
    "planned: goal=\"在携程上订一张5月18日昆明到北京价格最低的机票\" seed=\"semantic/site-a/index.html\" site=site-a",
    "signals/queries/fill bindings/row extraction are OBSERVED on the first walk;",
    "completion truth stays DOM/URL (induced, discriminating, reproducible across 2 demos).",
    "hints are NOT written here — the runtime backfill ring earns them on the first real runs."
  ]
}
