{
  "spec_version": 2,
  "id": "flight-cheapest",
  "label": "语义模板：订一张价格最低的机票（站点无关）",
  "goal": "订{date_label} {from}到{to}价格最低的机票",
  "model": "english",
  "slots": {
    "from": "昆明",
    "to": "北京",
    "date_label": "5月18日",
    "date_label_en": "May 18",
    "date_code": "05-18"
  },
  "sites": {
    "site-a": { "label": "云程旅行 复刻站 A（ids + 中文标签）", "start_url": "semantic/site-a/index.html" },
    "site-b": { "label": "Fareport 复刻站 B（data-test + 英文，不同页名/结构）", "start_url": "semantic/site-b/home.html" }
  },
  "pages": {
    "home": "index.html",
    "search": "search.html",
    "results": "results.html",
    "purchase": "purchase.html",
    "done": "done.html"
  },
  "steps": [
    {
      "id": "open-flights",
      "desc": "进入机票预订频道",
      "page": "home",
      "semantic_target": { "role": "link", "text": ["机票", "Flights"] },
      "signal": { "page": "search" }
    },
    {
      "id": "submit-search",
      "desc": "在出发地填入{from}、到达地填入{to}，然后点击搜索",
      "page": "search",
      "semantic_targets": [
        { "role": "input", "text": ["出发城市", "Departure city"] },
        { "role": "input", "text": ["到达城市", "Arrival city"] },
        { "role": "button", "text": ["搜索", "Search"] }
      ],
      "fills": ["from", "to"],
      "signal": { "page": "results" }
    },
    {
      "id": "pick-date",
      "desc": "选择出发日期{date_label}",
      "page": "results",
      "page_query": "from={from}&to={to}",
      "semantic_target": { "role": "button", "text": ["{date_label}", "{date_label_en}"] },
      "signal": { "page": "results", "query": "date={date_code}" }
    },
    {
      "id": "pick-cheapest",
      "desc": "判断最低价机票并选中最低价的航班",
      "page": "results",
      "page_query": "from={from}&to={to}&date={date_code}",
      "list_step": { "op": "min", "by": "price", "act": "row" },
      "signal": { "page": "purchase" }
    },
    {
      "id": "purchase",
      "desc": "点击购买提交订单",
      "page": "purchase",
      "page_query": "from={from}&to={to}&date={date_code}",
      "semantic_target": { "role": "button", "text": ["购买", "Purchase"] },
      "signal": { "page": "done" },
      "dangerous": true
    }
  ],
  "invariants": [
    { "page": "done", "query": "order=" }
  ],
  "notes": [
    "对应诉求原文：访问 → 点机票 → 输入出发地 → 输入到达地 → 搜索 → 选择出发日期 → 判断最低价 → 点击购买。",
    "'访问首页'是每步的 start_url 导航（执行器每个子目标重新 goto），不是第 9 个点击步；",
    "'输入出发地/到达地/搜索'合为一步（submit-search）：执行器每个子目标重新导航，",
    "  分步填值会在下一次导航时丢失——多动作用有序语义目标 + 站点档案的 fill_keys 绑值，",
    "  二跑时已学 hint 点中搜索按钮，执行器的 pre-fill 守卫先按 fill_keys 填好两个字段。",
    "'判断最低价'是 list_step：对抽取的价格列求 min，模型不产出'选哪行'的判断。",
    "'点击购买'标 dangerous：默认拒绝，--allow-dangerous 或注入 confirmDangerous 才执行。",
    "语义目标里的日期文案是槽位（{date_label}/{date_label_en}），值来自数据袋，编译期替换。"
  ]
}
