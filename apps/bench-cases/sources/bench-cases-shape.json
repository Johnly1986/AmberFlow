{
  "name": "bench-cases-shape",
  "label": "长流程用例包的结构（jq，整个 stdout 是一个 JSON 文档）",
  "transport": {
    "client": "cli",
    "url_template": "bench/cases-live-long.json",
    "note": "真实命令行工具：jq 把 JSON 变形后整体输出，走 json_stdout 解析",
    "cli": {
      "bin": "jq",
      "argv": [
        "-c",
        "[.cases[] | {id: .id, platform: .platform, subgoals: (.subgoals | length)}]",
        "{url}"
      ],
      "cwd": ".",
      "exit_ok": [
        0
      ]
    },
    "version_pin": "jq-1.",
    "version_argv": [
      "--version"
    ]
  },
  "extract": {
    "kind": "json_stdout",
    "rows": "[]",
    "fields": {
      "id": "id",
      "platform": "platform",
      "subgoals": {
        "path": "subgoals",
        "ops": [
          "int"
        ]
      }
    }
  },
  "counts": [
    {
      "key": "cases",
      "label": "用例数"
    }
  ],
  "audits": [
    {
      "key": "no_platform",
      "label": "缺 platform 行",
      "field": "platform",
      "empty": true
    }
  ],
  "selects": [
    {
      "key": "fewest",
      "label": "子目标最少",
      "sort_by": [
        "subgoals"
      ]
    }
  ],
  "report": {
    "title": "长流程用例的结构（jq + json_stdout）",
    "source_note": "`jq -c '[.cases[] | {id, platform, subgoals:(.subgoals|length)}]' bench/cases-live-long.json`；整个 stdout 是一个 JSON 文档",
    "preview": {
      "columns": [
        "id",
        "platform",
        "subgoals"
      ],
      "limit": 5
    },
    "notes": [
      "`json_stdout` 与 `json_in_script` 只差入口：这个直接 `JSON.parse(stdout)`，那个从 HTML 里挖 `var X = {...}`。",
      "`rows: \"[]\"` 是路径语言里的「逐项」——哪个数组是数据行仍然是配置说的。"
    ]
  }
}
