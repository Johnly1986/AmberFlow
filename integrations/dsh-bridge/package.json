{
  "name": "@deepseek-ai/dsh-layawebuse-bridge",
  "version": "0.2.0-rc.2",
  "private": true,
  "description": "Bridge plugin exposing the LayaWebUse frozen-plan browser engine (apps/learn) as model-facing tools",
  "license": "MIT",
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "setup": "node scripts/setup-links.mjs",
    "build": "node node_modules/typescript/bin/tsc -b tsconfig.json",
    "test": "npm run build && node node_modules/vitest/vitest.mjs run",
    "test:offline": "npm run build && node node_modules/vitest/vitest.mjs run tests/bridge.spec.ts tests/service.spec.ts",
    "test:live": "npm run build && node node_modules/vitest/vitest.mjs run tests/live.spec.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
