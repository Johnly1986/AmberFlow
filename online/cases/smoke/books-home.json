{
  "id": "books-home",
  "site": "books",
  "tier": "smoke",
  "goal": "打开 Books to Scrape 首页并确认目录页存在",
  "start_url": "https://books.toscrape.com/",
  "tags": ["navigation", "public"],
  "invariants": [
    {
      "id": "catalogue-visible",
      "desc": "首页标题是 All products",
      "signal": { "css_text_contains": ["h1", "All products"] }
    },
    {
      "id": "products-present",
      "desc": "首页至少渲染出一个商品",
      "signal": { "css_exists": "article.product_pod" }
    }
  ],
  "oracle": { "kind": "css_count", "selector": "article.product_pod", "min": 1 }
}