{
  "spec_version": 2,
  "id": "llm-probe-e",
  "label": "在云程旅行订5月18日昆明到北京价格最低的机票",
  "goal": "在云程旅行订5月18日昆明到北京价格最低的机票",
  "model": "english",
  "slots": {
    "date_label": "5月18日",
    "date_code": "05-18",
    "date_label_en": "May 18",
    "from": "昆明",
    "to": "北京"
  },
  "sites": {
    "site-a": {
      "label": "site-a",
      "start_url": "semantic/site-a/index.html"
    }
  },
  "pages": {
    "index.html": "index.html",
    "search.html": "search.html",
    "results.html": "results.html",
    "航班预订页面": "purchase.html",
    "purchase.html": "purchase.html",
    "done.html": "done.html"
  },
  "steps": [
    {
      "id": "step1",
      "desc": "点击“机票预订”链接，进入机票搜索页面",
      "page": "index.html",
      "semantic_target": {
        "role": "link",
        "text": "机票预订"
      },
      "signal": {
        "page": "search.html"
      }
    },
    {
      "id": "step2",
      "desc": "填写出发城市为昆明，到达城市为北京，然后点击搜索按钮",
      "page": "search.html",
      "semantic_target": {
        "role": "button",
        "text": "搜索"
      },
      "fills": [
        "from",
        "to"
      ],
      "signal": {
        "page": "results.html"
      }
    },
    {
      "id": "step3",
      "desc": "点击日期标签 5月18日 以筛选航班",
      "page": "results.html",
      "page_query": "from={from}&to={to}",
      "semantic_target": {
        "role": "button",
        "text": "5月18日"
      },
      "signal": {
        "page": "results.html"
      }
    },
    {
      "id": "step4",
      "desc": "选择价格最低的航班（¥980）并点击订票",
      "page": "results.html",
      "page_query": "from={from}&to={to}&date={date_code}",
      "semantic_target": {
        "role": "button",
        "text": "订票"
      },
      "list_step": {
        "op": "min",
        "by": "price"
      },
      "signal": {
        "page": "航班预订页面"
      }
    },
    {
      "id": "step5",
      "desc": "点击购买按钮完成机票订单",
      "page": "purchase.html",
      "page_query": "from={from}&to={to}&date={date_code}",
      "semantic_target": {
        "role": "button",
        "text": "购买"
      },
      "signal": {
        "page": "done.html"
      },
      "dangerous": true
    }
  ],
  "invariants": [
    {
      "page": "done.html"
    }
  ],
  "notes": [
    "planned: goal=\"在云程旅行订5月18日昆明到北京价格最低的机票\" seed=\"semantic/site-a/index.html\" site=site-a",
    "signals/queries/fill bindings/row extraction are OBSERVED on the first walk;",
    "completion truth stays DOM/URL (induced, discriminating, reproducible across 2 demos).",
    "hints are NOT written here — the runtime backfill ring earns them on the first real runs."
  ]
}
