{
  "spec_version": 2,
  "site": "site-a",
  "label": "planned profile for site-a",
  "locale": "zh",
  "checkpoint": "multilingual",
  "page_query": {
    "step3": "from={from}&to={to}",
    "step4": "from={from}&to={to}&date={date_code}",
    "step5": "from={from}&to={to}&date={date_code}"
  },
  "fill_keys": {
    "step2": {
      "出发城市": "from",
      "到达城市": "to"
    }
  },
  "list_extract": {
    "step4": {
      "row_sel": "tr.flight-item",
      "fields": {
        "price": {
          "sel": ".price",
          "op": "int"
        },
        "flight": {
          "sel": ".fno",
          "op": "str"
        }
      },
      "act_sel": "button.btn-pick"
    }
  },
  "frozen_signals": {
    "step1": {
      "url_contains": "/search.html"
    },
    "step2": {
      "url_contains": "/results.html"
    },
    "step3": {
      "css_text_equals": [
        "#list-state",
        "列表已更新 {date_code}"
      ]
    },
    "step4": {
      "url_contains": "/purchase.html"
    },
    "step5": {
      "url_contains": "/done.html"
    }
  },
  "steps": {}
}
