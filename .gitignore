# Node / TypeScript
node_modules/
dist/
coverage/
*.tsbuildinfo
.npm/

# 本机配置（含凭据）：configs/amberflowrc.json 只活在本地；模板 configs/amberflowrc.example.json 入库
configs/amberflowrc.json

# 模型产物（大文件缓存）：默认下载到项目目录 models/（图 + 外置权重 + tokenizer）
/models/

# 用户作用域目录（AMBERFLOW_HOME 的仓库内形态；默认是 ~/.amberflow，不在 checkout 里）
/.amberflow/

# 运行产物：计划 checkpoint、线上测试证据
.task_state.json
.task_plan.json
/online-runs/
/online-out/

# 输出目录（会话级产出，不入库）
/output/

# 文档缩略图缓存（编辑器生成）
/.thumbs/
docs/.thumbs/

# 本地临时工作区（会话/实验脚本与日志，不入库）
/.session_tmps/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp
iterations/*
travel/*

# 私有方向分析文档（项目所有者指定不入库）
/docs/direction/
