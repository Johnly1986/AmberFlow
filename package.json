{
  "name": "amberflow",
  "version": "2.0.0",
  "private": true,
  "bin": {
    "amber": "bin/amber.mjs"
  },
  "type": "module",
  "description": "冻结计划的浏览器自动化中间件：LLM 只规划一次，laya 逐步执行，完成只认 DOM 信号",
  "exports": {
    "./dsh-plugin": "./integrations/dsh-bridge/src/index.ts",
    "./client": "./integrations/dsh-bridge/client-root.js",
    "./locale/*.json": "./integrations/dsh-bridge/locale/*.json",
    ".": "./integrations/dsh-bridge/src/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "prepare": "node scripts/bootstrap.mjs",
    "start": "node --experimental-strip-types src/cli/start.ts",
    "amber": "node --experimental-strip-types src/cli/main.ts",
    "cli": "node --experimental-strip-types src/cli/main.ts",
    "doctor": "node --experimental-strip-types src/cli/start.ts --doctor",
    "model:fetch": "node --experimental-strip-types src/model/model-fetch.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run config:example:check && npm run online:validate",
    "online": "node --experimental-strip-types src/cli/online.ts",
    "online:validate": "node --experimental-strip-types src/cli/online.ts --validate",
    "apps": "node --experimental-strip-types src/app/app-runner.ts",
    "semantic": "node --experimental-strip-types src/flow/semantic-flow.ts",
    "plan:flow": "node --experimental-strip-types src/flow/plan-flow.ts",
    "plan-cli": "node --experimental-strip-types tools/plan_cli.ts",
    "picker-server": "node --experimental-strip-types src/cli/picker-server.ts",
    "learn": "node --experimental-strip-types tools/learn.ts",
    "agent": "node --experimental-strip-types tools/learn.ts --json --yes",
    "config:example": "node --experimental-strip-types tools/config-example.ts",
    "config:example:check": "node --experimental-strip-types tools/config-example.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-node": "^1.30.0",
    "playwright": "1.58.0"
  },
  "icon": "./integrations/dsh-bridge/icon.svg"
}
