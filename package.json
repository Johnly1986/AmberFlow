{
  "name": "amberflow",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "amber": "bin/amber.mjs"
  },
  "type": "module",
  "description": "冻结计划的浏览器自动化中间件：LLM 只规划一次，laya 逐步执行，完成只认 DOM 信号",
  "exports": {
    "./dsh-plugin": "./integrations/dsh-bridge/src/index.ts",
    "./client": "./integrations/dsh-bridge/client-root.js",
    "./locale/*.json": "./integrations/dsh-bridge/locale/*.json",
    ".": "./integrations/dsh-bridge/src/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "prepare": "node scripts/bootstrap.mjs",
    "start": "node --experimental-strip-types src/cli/start.ts",
    "amber": "node --experimental-strip-types src/cli/main.ts",
    "doctor": "node --experimental-strip-types src/cli/start.ts --doctor",
    "model:fetch": "node --experimental-strip-types src/model/model-fetch.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bridge": "npm --prefix integrations/dsh-bridge run test",
    "test:bridge:offline": "npm --prefix integrations/dsh-bridge run build && npx vitest run --root integrations/dsh-bridge tests/bridge.spec.ts tests/service.spec.ts tests/client.spec.ts",
    "parity": "node --experimental-strip-types tools/parity.ts",
    "parity:extraction": "node --experimental-strip-types tools/extraction-parity.ts",
    "parity:executor": "node --experimental-strip-types tools/executor-parity.ts",
    "parity:datasource": "node --experimental-strip-types tools/datasource-parity.ts",
    "parity:ctrip": "node --experimental-strip-types tools/ctrip-parity.ts",
    "parity:transfer": "node --experimental-strip-types tools/transfer-parity.ts",
    "test:parity": "npm run parity && npm run parity:extraction && npm run parity:executor && npm run parity:datasource && npm run parity:ctrip && npm run parity:transfer",
    "verify": "npm run typecheck && npm test && npm run test:parity",
    "bench": "node --experimental-strip-types src/cli/bench.ts",
    "apps": "node --experimental-strip-types src/app/app-runner.ts",
    "semantic": "node --experimental-strip-types src/flow/semantic-flow.ts",
    "plan:flow": "node --experimental-strip-types src/flow/plan-flow.ts",
    "bench:fixtures": "node --experimental-strip-types src/cli/bench.ts --fixtures-only --mode-tag smoke --out bench/results",
    "plan-cli": "node --experimental-strip-types tools/plan_cli.ts",
    "apps:matrix": "node --experimental-strip-types tools/apps_matrix.ts",
    "shortlist": "node --experimental-strip-types tools/shortlist_demo.ts",
    "ip-config": "node --experimental-strip-types src/cli/ip-config.ts",
    "camera-entry": "node --experimental-strip-types src/cli/camera-entry.ts",
    "picker-server": "node --experimental-strip-types src/cli/picker-server.ts",
    "induce": "node --experimental-strip-types tools/induce_signal.ts",
    "cache:measure": "node --experimental-strip-types tools/cache_measure.ts",
    "calibration": "node --experimental-strip-types tools/calibration.ts",
    "model:contribution": "node --experimental-strip-types tools/model-contribution.ts",
    "hint:measure": "node --experimental-strip-types tools/hint_measure.ts",
    "apps:suite": "node --experimental-strip-types tools/apps_suite.ts",
    "apps:gen": "node --experimental-strip-types tools/spec-to-pack.ts",
    "probes:baseline": "node --experimental-strip-types tools/probe-baseline.ts",
    "apps:induce": "node --experimental-strip-types tools/apps-induce.ts",
    "learn": "node --experimental-strip-types tools/learn.ts",
    "agent": "node --experimental-strip-types tools/learn.ts --json --yes",
    "metrics": "node --experimental-strip-types tools/arch-metrics.ts",
    "gate:signals": "node --experimental-strip-types tools/gate-signals.ts",
    "nominate:measure": "node --experimental-strip-types tools/instruction_nomination.ts",
    "providers:baseline": "node --experimental-strip-types tools/provider-baselines.ts",
    "probe:tokenplan": "node tools/probe-tokenplan.mjs",
    "nominate:online": "node --experimental-strip-types tools/instruction_nomination.ts --provider token-plan",
    "nominate:context": "node --experimental-strip-types tools/instruction_nomination.ts --context --provider token-plan"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "exceljs": "^4.4.0",
    "onnxruntime-node": "^1.30.0",
    "playwright": "1.58.0"
  },
  "icon": "./integrations/dsh-bridge/icon.svg"
}
