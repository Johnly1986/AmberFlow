{
  "name": "amberflow",
  "version": "2.0.0",
  "bin": {
    "amber": "bin/amber.mjs"
  },
  "type": "module",
  "description": "冻结计划的浏览器自动化中间件：计划由人给出，执行器逐步选择元素、动作并检查可验证信号；模型只做选择、风险与完成票，不生成动作。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johnly1986/AmberFlow.git"
  },
  "homepage": "https://github.com/Johnly1986/AmberFlow#readme",
  "bugs": {
    "url": "https://github.com/Johnly1986/AmberFlow/issues"
  },
  "exports": {
    "./dsh-plugin": "./integrations/dsh-bridge/src/index.ts",
    "./client": "./integrations/dsh-bridge/client-root.js",
    "./locale/*.json": "./integrations/dsh-bridge/locale/*.json",
    ".": "./integrations/dsh-bridge/src/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "prepare": "node scripts/bootstrap.mjs",
    "start": "node --experimental-strip-types src/cli/start.ts",
    "amber": "node --experimental-strip-types src/cli/main.ts",
    "cli": "node --experimental-strip-types src/cli/main.ts",
    "doctor": "node --experimental-strip-types src/cli/start.ts --doctor",
    "model:fetch": "node --experimental-strip-types src/model/model-fetch.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run precheck && npm run run-args:check && npm run session-contract:check && npm run typecheck && npm run config:example:check && npm run schema:check && npm run prompt-hit && npm run site-knowledge:check && npm run secret-scan && npm run examples-check && npm run bridge:test && npm run row-anchor:check && npm run laya-truncation:check && npm run verify:element-views && npm run maintain:check && npm run split:check && npm run test:validate && npm run verify:decision-run-parity",
    "test": "node --experimental-strip-types src/cli/test.ts",
    "test:validate": "node --experimental-strip-types src/cli/test.ts --validate",
    "apps": "node --experimental-strip-types src/app/app-runner.ts",
    "plan-cli": "node --experimental-strip-types tools/plan_cli.ts",
    "picker-server": "node --experimental-strip-types src/cli/picker-server.ts",
    "learn": "node --experimental-strip-types tools/learn.ts",
    "agent": "node --experimental-strip-types tools/learn.ts --json --yes",
    "config:example": "node --experimental-strip-types tools/config-example.ts",
    "config:example:check": "node --experimental-strip-types tools/config-example.ts --check",
    "schema:check": "node --experimental-strip-types src/cli/main.ts schema ctx --check",
    "row-anchor:check": "node --experimental-strip-types tools/row-anchor-check.ts",
    "prompt-hit": "node --experimental-strip-types tools/prompt-hit.ts",
    "golden-manual": "node --experimental-strip-types tools/golden-manual.ts",
    "secret-scan": "node --experimental-strip-types tools/secret-scan.ts",
    "examples-check": "node --experimental-strip-types tools/examples-check.ts",
    "bridge:test": "node --experimental-strip-types --test integrations/dsh-bridge/test/passthrough.test.ts",
    "bridge:typecheck": "node integrations/dsh-bridge/node_modules/typescript/bin/tsc -p integrations/dsh-bridge/tsconfig.json --noEmit",
    "check:ci": "node --experimental-strip-types src/cli/main.ts schema ctx --out dist/schema/ctx.json && npm run check",
    "precheck": "node --experimental-strip-types tools/schema-ensure.ts",
    "run-args:gen": "node --experimental-strip-types tools/run-args-gen.ts --write",
    "run-args:check": "node --experimental-strip-types tools/run-args-gen.ts --check",
    "laya-truncation:check": "node --experimental-strip-types tools/laya-truncation-check.ts",
    "verify:run-execution": "node --experimental-strip-types tools/verify-run-execution.ts",
    "verify:run-execution:record": "node --experimental-strip-types tools/verify-run-execution.ts --record",
    "verify:session:close": "node --experimental-strip-types tools/verify-session-close.ts",
    "maintain:check": "node --experimental-strip-types tools/maintain/index.ts",
    "split:check": "node --experimental-strip-types tools/split-check.ts",
    "verify:offline": "node --experimental-strip-types tools/verify-offline.ts",
    "verify:offline:record": "node --experimental-strip-types tools/verify-offline.ts --record",
    "verify:runtime:offline": "node --experimental-strip-types tools/verify-runtime-offline.ts",
    "verify:runtime:offline:record": "node --experimental-strip-types tools/verify-runtime-offline.ts --record",
    "site-knowledge:check": "node --experimental-strip-types tools/site-knowledge-check.ts",
    "verify:pilot": "node --experimental-strip-types tools/verify-pilot.ts",
    "verify:nav-error": "node --experimental-strip-types tools/verify-nav-error.ts",
    "verify:parity": "node --experimental-strip-types tools/verify-parity.ts",
    "verify:decision-context": "node --experimental-strip-types tools/verify-decision-context.ts",
    "verify:decision-run-parity": "node --experimental-strip-types tools/verify-decision-run-parity.ts --check",
    "verify:decision-characterization": "node --experimental-strip-types tools/verify-decision-characterization.ts",
    "verify:model-face": "node --experimental-strip-types tools/verify-model-face.ts",
    "verify:element-views": "node --experimental-strip-types tools/verify-element-views.ts",
    "verify:act-lock": "node --experimental-strip-types tools/verify-act-lock.ts",
    "verify:session-range": "node --experimental-strip-types tools/verify-session-range.ts",
    "verify:session-drive": "node --experimental-strip-types tools/verify-session-drive.ts",
    "verify:poolless-actions": "node --experimental-strip-types tools/verify-poolless-actions.ts",
    "verify:dedup-controls": "node --experimental-strip-types tools/verify-dedup-controls.ts",
    "verify:frame-budget": "node --experimental-strip-types tools/verify-frame-budget.ts",
    "verify:frame-exempt": "node --experimental-strip-types tools/verify-frame-exempt.ts",
    "verify:app-stop-context": "node --experimental-strip-types tools/verify-app-stop-context.ts",
    "verify:decision-accounting": "node --experimental-strip-types tools/verify-decision-accounting.ts",
    "verify:decision-ask-parity": "node --experimental-strip-types tools/verify-decision-ask-parity.ts",
    "verify:lanes": "npm run golden-manual && npm run verify:run-execution && npm run verify:offline && npm run verify:decision-accounting && npm run verify:act-lock && npm run verify:session-range && npm run verify:session-drive && npm run verify:poolless-actions && npm run verify:dedup-controls && npm run verify:frame-budget && npm run verify:frame-exempt && npm run verify:app-stop-context && npm run verify:decision-ask-parity && npm run verify:record-failure && npm run verify:ctx-validate && npm run verify:rehydrate-rescan && npm run verify:decision-endpoint-parity && npm run verify:run-view-parity && npm run verify:rule-vocab && echo \"verify:lanes: OK — 19 non-gated lanes passed\"",
    "verify:record-failure": "node --experimental-strip-types tools/verify-record-failure.ts",
    "verify:ctx-validate": "node --experimental-strip-types tools/verify-ctx-validate.ts",
    "verify:rehydrate-rescan": "node --experimental-strip-types tools/verify-rehydrate-rescan.ts",
    "session-contract:gen": "node --experimental-strip-types tools/session-contract-gen.ts --write",
    "session-contract:check": "node --experimental-strip-types tools/session-contract-gen.ts --check",
    "verify:decision-endpoint-parity": "node --experimental-strip-types tools/verify-decision-endpoint-parity.ts",
    "verify:run-view-parity": "node --experimental-strip-types tools/verify-run-view-parity.ts",
    "verify:rule-vocab": "node --experimental-strip-types tools/verify-rule-vocab.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "onnxruntime-node": "^1.30.0",
    "playwright": "1.58.0"
  },
  "files": [
    "bin/",
    "src/",
    "tools/",
    "configs/",
    "scripts/",
    "docs/",
    "examples/",
    "online/",
    "CHANGELOG.md",
    "SECURITY.md",
    "dsh-bundle.yml",
    "integrations/dsh-bridge/src/",
    "integrations/dsh-bridge/client.js",
    "integrations/dsh-bridge/client-root.js",
    "integrations/dsh-bridge/cordis.patch.yml",
    "integrations/dsh-bridge/icon.svg",
    "integrations/dsh-bridge/locale/"
  ],
  "icon": "./integrations/dsh-bridge/icon.svg",
  "publishConfig": {
    "access": "public"
  }
}
